SQUARE_ENVIRONMENT=sandbox
# Options: sandbox, production
# Optional: Square List Bookings sometimes drops one instance; paste that appointment’s booking ID (comma-separated for several).
# SQUARE_SUPPLEMENT_BOOKING_IDS=
# Optional: Square customer IDs (comma-separated) — extra list-by-customer queries for that day’s window.
# Use for recurring weekly clients (e.g. missing Saturday 10am) when the generic list still drops their instance.
# SQUARE_SUPPLEMENT_CUSTOMER_IDS=

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PORT=5000

# Service Configuration
COUPLES_MASSAGE_SERVICE_ID=your_couples_massage_service_id_here
# OR use service name pattern matching:
COUPLES_MASSAGE_SERVICE_NAME_PATTERN=couple

# Availability audit: GET /api/availability-audit?date=YYYY-MM-DD — Square online slots vs physical rooms (block times in Square when Square is open but rooms are not).
# Paste catalog ITEM_VARIATION ids from Square Dashboard (same as online booking). Optional if resolve names work.
# SQUARE_AUDIT_SINGLE_VARIATION_ID=
# SQUARE_AUDIT_COUPLE_VARIATION_ID=
# SQUARE_AUDIT_SINGLE_SERVICE_NAME=Swedish Massage
# SQUARE_AUDIT_COUPLE_SERVICE_NAME=Couples Massage
# SQUARE_AUDIT_DURATION_MINUTES=60

# Therapist Configuration
# Comma-separated list of team member IDs to consider for couple's massages
# Leave empty to use all available team members
THERAPIST_TEAM_MEMBER_IDS=

# Couple autoblock (M10): auto-block the second therapist in Square for couples massages.
# Runs inside the 8001 server as a background poller. DRY RUN by default: it only reports
# what it would create (see GET /api/couple-autoblock/status); set DRY_RUN=false to write to Square.
# COUPLE_AUTOBLOCK_ENABLED=true
# COUPLE_AUTOBLOCK_DRY_RUN=true
# COUPLE_AUTOBLOCK_POLL_MINUTES=5
# COUPLE_AUTOBLOCK_LOOKAHEAD_DAYS=7
# COUPLE_AUTOBLOCK_MARKER=AUTO-BLOCK:
# Placeholder customer shown on the Square calendar tile for blocks (created automatically if missing):
# COUPLE_AUTOBLOCK_CUSTOMER_GIVEN_NAME=AUTO
# COUPLE_AUTOBLOCK_CUSTOMER_FAMILY_NAME=BLOCK
# COUPLE_AUTOBLOCK_CUSTOMER_ID=

